---
import Layout from '../layout/layout.astro';
import { SEO_CONFIG } from '../utils/seo.js';

const sitePages = [
  {
    title: 'Home',
    url: '/',
    description: 'Pagina principale di Speedy Pizza con informazioni generali e contatti',
    lastmod: '2025-06-04'
  },
  {
    title: 'Menu',
    url: '/menu',
    description: 'Il nostro menu completo con tutte le pizze disponibili per asporto e consegna',
    lastmod: '2025-06-04'
  },
  {
    title: 'Sitemap',
    url: '/sitemap',
    description: 'Mappa del sito con tutte le pagine disponibili',
    lastmod: '2025-06-04'
  }
];
---

<Layout 
  title="Mappa del Sito"
  description="Mappa completa del sito Speedy Pizza con tutte le pagine e sezioni disponibili."
  noindex={true}
>
  <section class="py-16 md:py-24 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 mb-4">Mappa del Sito</h1>
      <p class="text-lg text-slate-600 mb-10">
        Trova facilmente tutte le pagine e sezioni del nostro sito web.
      </p>
      
      <div class="grid gap-6 mb-12">
        {sitePages.map(page => (
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-2">
              <a href={page.url} class="text-red-600 hover:text-red-700 hover:underline transition-colors">{page.title}</a>
            </h3>
            <p class="text-slate-600 mb-2">{page.description}</p>
            <small class="text-slate-400 text-sm">Ultimo aggiornamento: {page.lastmod}</small>
          </div>
        ))}
      </div>
      
      <div class="border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-serif font-bold text-slate-900 mb-6">Informazioni Aggiuntive</h2>
        <ul class="space-y-3">
          <li class="flex flex-col sm:flex-row sm:items-center gap-2 pb-3 border-b border-slate-100 last:border-0">
            <strong class="text-slate-700 w-32">Sitemap XML:</strong> 
            <a href="/sitemap-index.xml" class="text-red-600 hover:text-red-700 hover:underline transition-colors">sitemap-index.xml</a>
          </li>
          <li class="flex flex-col sm:flex-row sm:items-center gap-2 pb-3 border-b border-slate-100 last:border-0">
            <strong class="text-slate-700 w-32">Robots.txt:</strong> 
            <a href="/robots.txt" class="text-red-600 hover:text-red-700 hover:underline transition-colors">robots.txt</a>
          </li>
          <li class="flex flex-col sm:flex-row sm:items-center gap-2 pb-3 border-b border-slate-100 last:border-0">
            <strong class="text-slate-700 w-32">Sito web:</strong> 
            <a href={SEO_CONFIG.SITE_URL} class="text-red-600 hover:text-red-700 hover:underline transition-colors">{SEO_CONFIG.SITE_URL}</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
