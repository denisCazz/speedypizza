---
import Layout from '../layout/layout.astro';
import { SEO_CONFIG } from '../utils/seo.js';
const phoneNumber = "011-9712328";
const address = "Via Valobra 117/119, Carmagnola";
const mapsUrl = SEO_CONFIG.MAPS_URL;
---

<Layout 
  title="Speedy Pizza Carmagnola"
  description="Speedy Pizza Carmagnola - Pizzeria d'asporto e consegna a domicilio in Via Valobra 117/119. Le migliori pizze artigianali di Carmagnola con ingredienti freschi."
  type="website"
>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center bg-black overflow-hidden">
    <!-- Animated gradient mesh background -->
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(220,38,38,0.15)_0%,_transparent_50%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(251,146,60,0.1)_0%,_transparent_50%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.02)_0%,_transparent_70%)]"></div>
    </div>
    
    <!-- Floating orbs -->
    <div class="absolute top-20 left-[15%] w-72 h-72 bg-red-500/20 rounded-full blur-[100px] animate-pulse"></div>
    <div class="absolute bottom-20 right-[10%] w-96 h-96 bg-orange-500/15 rounded-full blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-red-600/5 rounded-full blur-[150px]"></div>
    
    <!-- Noise texture overlay -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
    
    <!-- Grid lines -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:100px_100px]"></div>
    
    <!-- Content -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col justify-center min-h-screen py-20">
      <div class="space-y-6">
        <!-- Badge -->
        <div class="hero-animate opacity-0 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm" style="animation-delay: 0.2s;">
          <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
          <span class="text-sm text-white/70 font-medium tracking-wide">Pizzeria a Carmagnola</span>
        </div>
        
        <!-- Main title -->
        <div class="space-y-2">
          <h1 class="hero-animate opacity-0 text-6xl md:text-8xl lg:text-9xl font-bold text-white tracking-tighter" style="animation-delay: 0.4s;">
            Speedy
          </h1>
          <h2 class="hero-animate opacity-0 text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter" style="animation-delay: 0.6s;">
            <span class="bg-gradient-to-r from-red-500 via-orange-400 to-red-500 bg-clip-text text-transparent">Pizza</span>
          </h2>
        </div>
        
        <!-- Subtitle -->
        <p class="hero-animate opacity-0 text-lg md:text-xl text-white/50 max-w-md mx-auto font-light tracking-wide" style="animation-delay: 0.8s;">
          Asporto e consegna a domicilio
        </p>
        
        <!-- CTA Buttons -->
        <div class="hero-animate opacity-0 flex flex-col sm:flex-row gap-4 justify-center items-center pt-4" style="animation-delay: 1s;">
          <a href="/menu" class="group relative px-8 py-4 bg-white text-black font-bold rounded-full overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,255,255,0.2)]">
            <span class="relative z-10">Vedi il Menu</span>
          </a>
          <a href={`tel:${phoneNumber.replace(/-/g, '')}`} class="group px-8 py-4 font-semibold rounded-full border border-white/20 text-white hover:bg-white/10 transition-all duration-300 flex items-center gap-3">
            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span>{phoneNumber}</span>
          </a>
        </div>
      </div>
      
      <!-- Scroll indicator inside content flow -->
      <div class="hero-animate opacity-0 mt-8 md:mt-auto pt-6 md:pt-12 flex flex-col items-center gap-2" style="animation-delay: 1.4s;">
        <span class="text-xs tracking-widest uppercase text-white/60 font-medium">Scorri</span>
        <div class="w-6 h-10 rounded-full border-2 border-white/30 flex justify-center pt-2">
          <div class="w-1 h-2 bg-white/60 rounded-full animate-bounce"></div>
        </div>
      </div>
    </div>
    
    <!-- Bottom gradient fade -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-gray-950 to-transparent pointer-events-none"></div>
  </section>

  <!-- Hero animations -->
  <style>
    @keyframes heroFadeIn {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .hero-animate {
      animation: heroFadeIn 0.8s ease-out forwards;
    }
  </style>

  <!-- About Section -->
  <section class="py-24 md:py-32 bg-gray-950 relative" id="about">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Image -->
        <div class="relative group">
          <div class="absolute -inset-4 bg-gradient-to-r from-red-500/20 to-orange-500/20 rounded-3xl blur-2xl opacity-0 group-hover:opacity-100 transition-all duration-700"></div>
          <div class="relative overflow-hidden rounded-2xl">
            <img src="/logo.jpeg" alt="Speedy Pizza Carmagnola" class="w-full max-w-md mx-auto rounded-2xl shadow-2xl transition-transform duration-700 group-hover:scale-[1.02]"/>
          </div>
        </div>
        
        <!-- Text content -->
        <div class="space-y-8">
          <div>
            <span class="text-red-500 font-semibold text-sm tracking-widest uppercase">Chi siamo</span>
            <h2 class="text-4xl md:text-5xl font-bold text-white mt-4 leading-tight">Passione per la pizza dal cuore di Carmagnola</h2>
          </div>
          
          <div class="space-y-4 text-gray-400 text-lg leading-relaxed">
            <p>
              Da <strong class="text-white">{address}</strong>, portiamo la tradizione della pizza italiana direttamente a casa tua.
            </p>
            <p>
              Ingredienti freschi, impasto lievitato con cura e cottura perfetta. Ogni pizza racconta la nostra passione.
            </p>
          </div>
          
          <div class="flex items-center gap-6 pt-4">
            <div class="text-center">
              <div class="text-3xl font-bold text-white">18:00</div>
              <div class="text-sm text-gray-500">Apertura</div>
            </div>
            <div class="w-px h-12 bg-gray-800"></div>
            <div class="text-center">
              <div class="text-3xl font-bold text-white">22:00</div>
              <div class="text-sm text-gray-500">Chiusura</div>
            </div>
            <div class="w-px h-12 bg-gray-800"></div>
            <div class="text-center">
              <div class="text-3xl font-bold text-red-500">7/7</div>
              <div class="text-sm text-gray-500">Giorni</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-24 md:py-32 bg-gray-900" id="contact">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-red-500 font-semibold text-sm tracking-widest uppercase">Contatti</span>
        <h2 class="text-4xl md:text-5xl font-bold text-white mt-4">Ordina Ora</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <!-- Address Card -->
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="group p-8 bg-gray-800/50 rounded-2xl border border-gray-700/50 hover:border-gray-600 hover:bg-gray-800 transition-all duration-300 text-center">
          <div class="w-12 h-12 bg-gray-700/50 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-red-500/20 group-hover:scale-110 transition-all duration-300">
            <svg class="w-6 h-6 text-gray-400 group-hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="font-bold text-white mb-2">Indirizzo</h3>
          <p class="text-gray-400 text-sm">{address}</p>
          <span class="inline-block mt-4 text-red-500 text-sm font-medium group-hover:underline">Apri Maps &rarr;</span>
        </a>

        <!-- Phone Card -->
        <a href={`tel:${phoneNumber.replace(/-/g, '')}`} class="group p-8 bg-red-600 rounded-2xl text-center hover:scale-[1.02] transition-all duration-300 hover:shadow-2xl hover:shadow-red-500/20">
          <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-all duration-300">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <h3 class="font-bold text-white mb-2">Telefono</h3>
          <p class="text-2xl font-bold text-white">{phoneNumber}</p>
          <span class="inline-block mt-4 px-6 py-2 bg-white text-red-600 text-sm font-bold rounded-full group-hover:bg-gray-100 transition-colors">Chiama</span>
        </a>

        <!-- Hours Card -->
        <div class="group p-8 bg-gray-800/50 rounded-2xl border border-gray-700/50 hover:border-gray-600 hover:bg-gray-800 transition-all duration-300 text-center">
          <div class="w-12 h-12 bg-gray-700/50 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-red-500/20 group-hover:scale-110 transition-all duration-300">
            <svg class="w-6 h-6 text-gray-400 group-hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="font-bold text-white mb-2">Orari</h3>
          <p class="text-gray-400 text-sm">Tutti i giorni</p>
          <p class="text-2xl font-bold text-white mt-2">18 - 22</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
