---
import Layout from '../layout/layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
// Modifica l'importazione: 'menuData' ora si riferisce direttamente all'oggetto JSON.
import * as menuData from '../../menu.json';

const nonVegetarianIngredients = [
  "prosciutto", "acciughe", "wurstel", "salamino piccante", "tonno", 
  "salsiccia", "prosciutto crudo", "frutti di mare", "speck", "bresaola", 
  "pancetta", "gamberetti", "nduja", "porchetta"
];

const spicyIngredients = ["salamino piccante", "peperoncino", "nduja"];

const allProdotti = menuData.categorie.flatMap(cat => cat.prodotti);

const pizzas = allProdotti.map(pizza => {
  const lowerCaseIngredients = pizza.ingredienti.map(ing => ing.toLowerCase());
  return {
    name: pizza.nome,
    ingredients: pizza.ingredienti.join(', '),
    price: `€ ${pizza.prezzo.toFixed(2)}`,
    isVegetarian: !lowerCaseIngredients.some(ing => nonVegetarianIngredients.includes(ing)),
    isSpicy: lowerCaseIngredients.some(ing => spicyIngredients.includes(ing))
  };
});

const extraNote = menuData.extra.note;

// Prepara i dati per lo script client-side
const clientSidePizzas = pizzas.map(p => ({
  name: p.name,
  ingredients: p.ingredients,
  price: p.price,
  isVegetarian: p.isVegetarian,
  isSpicy: p.isSpicy
}));

const phoneNumber = menuData.telefono;
---

<Layout 
  title="Menu Pizza Carmagnola"
  description="Scopri il menu completo di Speedy Pizza Carmagnola: pizze tradizionali e gourmet, preparate con ingredienti freschi. Ordina per consegna a domicilio o asporto."
  keywords={["menu pizza Carmagnola", "pizze Carmagnola", "menu pizzeria Carmagnola", "ordine pizza Carmagnola", "pizze asporto Carmagnola"]}
>
  <section class="pt-28 pb-16 bg-gray-950 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb 
        items={[
          { name: 'Menu', url: '/menu' }
        ]}
      />
      
      <div class="text-center mb-12">
        <span class="inline-block px-5 py-2 mb-4 text-sm font-semibold text-red-400 bg-red-500/10 rounded-full border border-red-500/20">
          Le nostre pizze
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Menu d'Asporto</h1>
        <div class="w-20 h-1 bg-gradient-to-r from-red-500 to-orange-500 mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-6">
          Scopri la nostra selezione di pizze, preparate con ingredienti freschi e amore.
          <br />
          Per ordini: <a href={`tel:${menuData.telefono.replace(/-/g, '')}`} class="text-red-500 font-bold hover:underline transition-colors">{menuData.telefono}</a>
        </p>
        <div class="flex justify-center gap-6 text-sm font-semibold text-gray-500">
          <span class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </span>
            Vegetariana
          </span>
          <span class="text-gray-700">|</span>
          <span class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-red-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path></svg>
            </span>
            Piccante
          </span>
        </div>
      </div>

      <div class="max-w-md mx-auto mb-8 relative">
        <input 
          type="text" 
          id="search-bar" 
          placeholder="Cerca per nome o ingrediente..." 
          aria-label="Cerca pizze"
          class="w-full px-6 py-4 rounded-full border border-gray-700 shadow-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all duration-300 text-white bg-gray-800/50 placeholder-gray-500"
        >
        <span class="absolute right-5 top-1/2 transform -translate-y-1/2 text-gray-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </span>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <button class="filter-btn active px-6 py-2.5 rounded-full bg-red-600 text-white shadow-lg shadow-red-500/20 transition-all duration-500 transform hover:-translate-y-0.5 font-bold" data-filter="all">
          Tutte
        </button>
        <button class="filter-btn px-6 py-2.5 rounded-full bg-gray-800 text-gray-400 border border-gray-700 hover:bg-emerald-500/10 hover:text-emerald-400 hover:border-emerald-500/30 shadow-sm transition-all duration-500 transform hover:-translate-y-0.5 font-bold flex items-center gap-2" data-filter="vegetarian">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Vegetariane
        </button>
        <button class="filter-btn px-6 py-2.5 rounded-full bg-gray-800 text-gray-400 border border-gray-700 hover:bg-red-500/10 hover:text-red-400 hover:border-red-500/30 shadow-sm transition-all duration-500 transform hover:-translate-y-0.5 font-bold flex items-center gap-2" data-filter="spicy">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path></svg>
          Piccanti
        </button>
      </div>



      <div id="menu-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 menu-grid">
        {pizzas.map((pizza, index) => (
          <div class="menu-item bg-gray-800/50 rounded-2xl border border-gray-700/50 hover:border-gray-600 hover:bg-gray-800 transition-all duration-400 p-5 flex flex-col h-full group hover:-translate-y-1" data-pizza-index={index}>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-white group-hover:text-red-400 transition-colors duration-300">
                {pizza.name}
              </h3>
              <div class="flex gap-1.5">
                {pizza.isVegetarian && (
                  <span class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center" title="Vegetariana">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  </span>
                )}
                {pizza.isSpicy && (
                  <span class="w-6 h-6 rounded-full bg-red-500/20 flex items-center justify-center" title="Piccante">
                    <svg class="w-3.5 h-3.5 text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path></svg>
                  </span>
                )}
              </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 flex-grow leading-relaxed">{pizza.ingredients}</p>
            <div class="flex justify-between items-center pt-3 border-t border-gray-700/50 mt-auto">
              <p class="text-lg font-bold text-red-500">{pizza.price}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 bg-gray-800/50 rounded-2xl border border-gray-700/50 p-8 max-w-3xl mx-auto">
        <h3 class="text-xl font-bold text-white mb-6 text-center border-b border-gray-700/50 pb-4">Supplementi e Extra</h3>
        <div class="text-center text-gray-300 text-sm py-2">
          <p>{extraNote}</p>
        </div>
        <div class="mt-5 pt-4 border-t border-gray-700/50 text-center text-xs text-gray-500">
          <p>Disponibile anche impasto integrale. Per allergeni chiedi al momento dell'ordine.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ clientSidePizzas }}>
  // Gestione ricerca e filtri
  const searchBar = document.getElementById('search-bar');
  const menuItemsNodeList = document.querySelectorAll('.menu-item');
  const menuItems = Array.from(menuItemsNodeList);
  const filterBtns = document.querySelectorAll('.filter-btn');
  let currentFilter = 'all';

  // Filter logic
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state UI - reset all buttons
      filterBtns.forEach(b => {
        b.classList.remove('bg-gradient-to-r', 'from-red-600', 'to-red-500', 'from-emerald-600', 'to-emerald-500', 'text-white', 'shadow-lg', 'shadow-red-500/25', 'shadow-emerald-500/25');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200', 'shadow-sm');
      });
      
      // Set active style for clicked button
      const filterType = btn.dataset.filter;
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200', 'shadow-sm');
      
      if (filterType === 'vegetarian') {
        btn.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-500', 'text-white', 'shadow-lg', 'shadow-emerald-500/25');
      } else {
        btn.classList.add('bg-gradient-to-r', 'from-red-600', 'to-red-500', 'text-white', 'shadow-lg', 'shadow-red-500/25');
      }

      currentFilter = filterType;
      filterItems();
    });
  });

  if (searchBar) {
    searchBar.addEventListener('input', filterItems);
  }

  function filterItems() {
    const searchTerm = searchBar ? searchBar.value.toLowerCase().trim() : '';

    menuItems.forEach((itemElement, index) => {
      const pizzaData = clientSidePizzas[index];
      
      if (!pizzaData) {
        itemElement.style.display = 'none';
        return;
      }

      // Search matching
      const nameMatches = pizzaData.name.toLowerCase().includes(searchTerm);
      const ingredientsMatch = pizzaData.ingredients.toLowerCase().includes(searchTerm);
      const searchMatch = nameMatches || ingredientsMatch;

      // Filter matching
      let filterMatch = true;
      if (currentFilter === 'vegetarian') {
        filterMatch = pizzaData.isVegetarian;
      } else if (currentFilter === 'spicy') {
        filterMatch = pizzaData.isSpicy;
      }

      if (searchMatch && filterMatch) {
        itemElement.style.display = '';
        itemElement.style.opacity = '0';
        itemElement.style.transform = 'translateY(20px)';
        requestAnimationFrame(() => {
          itemElement.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
          itemElement.style.opacity = '1';
          itemElement.style.transform = 'translateY(0)';
        });
      } else {
        itemElement.style.display = 'none';
      }
    });
  }
</script>
