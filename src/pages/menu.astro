---
import Layout from '../layout/layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
// Modifica l'importazione: 'menuData' ora si riferisce direttamente all'oggetto JSON.
import * as menuData from '../../menu.json';

const nonVegetarianIngredients = [
  "prosciutto", "acciughe", "wurstel", "salamino piccante", "tonno", 
  "salsiccia", "prosciutto crudo", "frutti di mare", "speck", "bresaola", 
  "pancetta", "gamberetti", "'nduja", "porchetta"
];

const spicyIngredients = ["salamino piccante", "peperoncino", "'nduja"];

const pizzas = menuData.pizze.map(pizza => {
  const lowerCaseIngredients = pizza.ingredienti.map(ing => ing.toLowerCase());
  return {
    name: pizza.nome,
    ingredients: pizza.ingredienti.join(', '),
    price: `€ ${pizza.prezzo.toFixed(2)}`,
    isVegetarian: !lowerCaseIngredients.some(ing => nonVegetarianIngredients.includes(ing)),
    isSpicy: lowerCaseIngredients.some(ing => spicyIngredients.includes(ing))
  };
});

const extraInfo = menuData.extra;

// Prepara i dati per lo script client-side
const clientSidePizzas = pizzas.map(p => ({
  name: p.name,
  ingredients: p.ingredients,
  price: p.price,
  isVegetarian: p.isVegetarian,
  isSpicy: p.isSpicy
}));

const phoneNumber = menuData.telefono;
---

<Layout 
  title="Il Nostro Menu"
  description="Scopri il menu completo di Speedy Pizza: pizze tradizionali e gourmet, preparate con ingredienti freschi e di qualità. Ordina per consegna a domicilio o ritiro."
  keywords={["menu pizza", "pizze Carmagnola", "menu pizzeria", "ordine pizza online", "pizze asporto"]}
>
  <section class="py-12 bg-slate-50 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb 
        items={[
          { name: 'Menu', url: '/menu' }
        ]}
      />
      
      <div class="text-center mb-12">
        <h1 class="text-4xl font-serif font-bold text-slate-900 mb-4">Il Nostro Menu d'Asporto</h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-6">
          Scopri la nostra selezione di pizze, preparate con ingredienti freschi e amore, pronte da portare via.
          <br />
          Siamo a {menuData.indirizzo}. Per ordini: <a href={`tel:${menuData.telefono.replace(/-/g, '')}`} class="text-red-600 font-bold hover:underline">{menuData.telefono}</a>
        </p>
        <div class="flex justify-center gap-4 text-sm font-medium text-slate-500">
          <span class="flex items-center gap-1"><span class="text-green-600">🌿</span> Vegetariana</span>
          <span class="text-slate-300">|</span>
          <span class="flex items-center gap-1"><span class="text-red-600">🌶️</span> Piccante</span>
        </div>
      </div>

      <div class="max-w-md mx-auto mb-6 relative">
        <input 
          type="text" 
          id="search-bar" 
          placeholder="Cerca per nome o ingrediente..." 
          aria-label="Cerca pizze"
          class="w-full px-6 py-3 rounded-full border border-slate-300 shadow-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all text-slate-700"
        >
        <span class="absolute right-4 top-1/2 transform -translate-y-1/2 text-slate-400">🔍</span>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <button class="filter-btn active px-5 py-2 rounded-full bg-red-600 text-white shadow-md transition-all transform hover:-translate-y-0.5 font-medium" data-filter="all">
          Tutte
        </button>
        <button class="filter-btn px-5 py-2 rounded-full bg-white text-slate-600 border border-slate-200 hover:bg-green-50 hover:text-green-700 hover:border-green-200 shadow-sm transition-all transform hover:-translate-y-0.5 font-medium flex items-center gap-2" data-filter="vegetarian">
          <span>🌿</span> Vegetariane
        </button>
        <button class="filter-btn px-5 py-2 rounded-full bg-white text-slate-600 border border-slate-200 hover:bg-red-50 hover:text-red-700 hover:border-red-200 shadow-sm transition-all transform hover:-translate-y-0.5 font-medium flex items-center gap-2" data-filter="spicy">
          <span>🌶️</span> Piccanti
        </button>
      </div>



      <div id="menu-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 menu-grid">
        {pizzas.map((pizza, index) => (
          <div class="menu-item bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 p-6 border border-slate-100 flex flex-col h-full group" data-pizza-index={index}>
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-red-600 transition-colors">
                {pizza.name}
              </h3>
              <div class="flex gap-1">
                {pizza.isVegetarian && <span class="text-lg" title="Vegetariana">🌿</span>}
                {pizza.isSpicy && <span class="text-lg" title="Piccante">🌶️</span>}
              </div>
            </div>
            <p class="text-slate-600 text-sm mb-6 flex-grow italic">{pizza.ingredients}</p>
            <div class="flex justify-between items-center pt-4 border-t border-slate-100 mt-auto">
              <p class="text-lg font-bold text-slate-800">{pizza.price}</p>

            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 bg-white rounded-xl shadow-sm border border-slate-200 p-8 max-w-3xl mx-auto">
        <h3 class="text-xl font-bold text-slate-900 mb-6 text-center border-b border-slate-100 pb-4">Supplementi e Extra</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-600">
          <div class="flex justify-between items-center p-2 hover:bg-slate-50 rounded">
            <span>Aggiunta ingredienti</span>
            <span class="font-bold">€ {extraInfo.aggiunta_ingredienti.toFixed(2)}</span>
          </div>
          <div class="flex justify-between items-center p-2 hover:bg-slate-50 rounded">
            <span>Aggiunta Burrata</span>
            <span class="font-bold">€ {extraInfo.aggiunta_burrata.toFixed(2)}</span>
          </div>
          <div class="flex justify-between items-center p-2 hover:bg-slate-50 rounded">
            <span>Aggiunta Patatine</span>
            <span class="font-bold">€ {extraInfo.aggiunta_patatine.toFixed(2)}</span>
          </div>
          <div class="flex justify-between items-center p-2 hover:bg-slate-50 rounded">
            <span>Aggiunta salumi pregiati</span>
            <span class="font-bold">€ {extraInfo.aggiunta_salumi_pregiati.toFixed(2)}</span>
          </div>
          <div class="flex justify-between items-center p-2 hover:bg-slate-50 rounded">
            <span>Aggiunta Mozzarella di Bufala</span>
            <span class="font-bold">€ {extraInfo.aggiunta_bufala.toFixed(2)}</span>
          </div>
          <div class="flex justify-between items-center p-2 hover:bg-slate-50 rounded text-green-600">
            <span>Sconto Pizza Baby</span>
            <span class="font-bold">-€ {extraInfo.pizza_baby_sconto.toFixed(2)}</span>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 text-center text-xs text-slate-500">
          <p>Tutte le nostre pizze sono disponibili anche con impasto integrale (supplemento da verificare al momento dell'ordine).</p>
          <p class="mt-1">Per allergeni o richieste particolari, non esitare a chiedere al nostro staff al momento dell'ordine!</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ clientSidePizzas }}>
  // Gestione ricerca e filtri
  const searchBar = document.getElementById('search-bar');
  const menuItemsNodeList = document.querySelectorAll('.menu-item');
  const menuItems = Array.from(menuItemsNodeList);
  const filterBtns = document.querySelectorAll('.filter-btn');
  let currentFilter = 'all';

  // Filter logic
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state UI
      filterBtns.forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'shadow-md');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200', 'shadow-sm');
      });
      
      // Set active style for clicked button
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200', 'shadow-sm');
      btn.classList.add('bg-red-600', 'text-white', 'shadow-md');
      
      // Special styling for vegetarian if active (optional, keeping it simple red for active for now to match "Tutte")
      // If you want specific colors for active states:
      const filterType = btn.dataset.filter;
      if (filterType === 'vegetarian') {
         btn.classList.remove('bg-red-600');
         btn.classList.add('bg-green-600');
      } else if (filterType === 'spicy') {
         // keep red
      } else {
         // keep red
      }

      currentFilter = filterType;
      filterItems();
    });
  });

  if (searchBar) {
    searchBar.addEventListener('input', filterItems);
  }

  function filterItems() {
    const searchTerm = searchBar ? searchBar.value.toLowerCase().trim() : '';

    menuItems.forEach((itemElement, index) => {
      const pizzaData = clientSidePizzas[index];
      
      if (!pizzaData) {
        itemElement.style.display = 'none';
        return;
      }

      // Search matching
      const nameMatches = pizzaData.name.toLowerCase().includes(searchTerm);
      const ingredientsMatch = pizzaData.ingredients.toLowerCase().includes(searchTerm);
      const searchMatch = nameMatches || ingredientsMatch;

      // Filter matching
      let filterMatch = true;
      if (currentFilter === 'vegetarian') {
        filterMatch = pizzaData.isVegetarian;
      } else if (currentFilter === 'spicy') {
        filterMatch = pizzaData.isSpicy;
      }

      if (searchMatch && filterMatch) {
        itemElement.style.display = '';
        // Add animation class for appearance
        itemElement.classList.add('fade-in');
      } else {
        itemElement.style.display = 'none';
        itemElement.classList.remove('fade-in');
      }
    });
  }
</script>
