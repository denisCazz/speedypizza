---
// Navbar.astro
---
<header class="fixed w-full top-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo.jpeg" alt="Speedy Pizza Logo" class="h-12 w-12 rounded-full border-2 border-red-500 shadow-md transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
          <span class="font-serif font-bold text-xl text-slate-800 tracking-tight group-hover:text-red-600 transition-colors">Speedy Pizza</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-slate-600 hover:text-red-600 font-medium transition-colors relative group">
          Home
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/menu" class="text-slate-600 hover:text-red-600 font-medium transition-colors relative group">
          Menu
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="tel:0119712328" class="inline-flex items-center justify-center px-5 py-2.5 border border-transparent rounded-full shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all transform hover:-translate-y-0.5">
          <span class="mr-2">📞</span> Ordina Ora
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center">
        <button type="button" class="navbar-toggle inline-flex items-center justify-center p-2 rounded-md text-slate-600 hover:text-red-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-red-500" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <!-- Icon when menu is closed -->
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Icon when menu is open -->
          <svg class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden bg-white border-t border-slate-100" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-red-600 hover:bg-red-50 transition-colors">Home</a>
      <a href="/menu" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-red-600 hover:bg-red-50 transition-colors">Menu</a>
      <a href="tel:0119712328" class="block w-full text-center mt-4 px-5 py-3 rounded-lg font-medium text-white bg-red-600 hover:bg-red-700 shadow-md transition-colors">
        📞 Chiama per Ordinare
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector('.navbar-toggle');
  const menu = document.getElementById('mobile-menu');
  const icons = btn?.querySelectorAll('svg');

  if (btn && menu && icons) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      
      // Toggle icons
      icons[0].classList.toggle('hidden');
      icons[0].classList.toggle('block');
      icons[1].classList.toggle('hidden');
      icons[1].classList.toggle('block');
    });
  }
</script>