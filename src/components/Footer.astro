---
const currentYear = new Date().getFullYear();
import { SEO_CONFIG } from '../utils/seo.js';
const SITE_NAME = SEO_CONFIG.SITE_NAME;
const ADDRESS = `${SEO_CONFIG.BUSINESS.address.street}, ${SEO_CONFIG.BUSINESS.address.city}`;
const PHONE_NUMBER = SEO_CONFIG.BUSINESS.phone;
const MAPS_URL = SEO_CONFIG.MAPS_URL;
---

<footer class="bg-black text-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div class="space-y-4">
        <h3 class="text-2xl font-bold">
          <span class="text-white">Speedy</span><span class="text-red-500">Pizza</span>
        </h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          La migliore pizza a Carmagnola.<br/>Consegna a domicilio e asporto.
        </p>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold text-white mb-4">Link</h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-400 hover:text-white text-sm transition-colors">Home</a></li>
          <li><a href="/menu" class="text-gray-400 hover:text-white text-sm transition-colors">Menu</a></li>
          <li><a href="/#about" class="text-gray-400 hover:text-white text-sm transition-colors">Chi Siamo</a></li>
          <li><a href="/#contact" class="text-gray-400 hover:text-white text-sm transition-colors">Contatti</a></li>
        </ul>
      </div>
      
      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-white mb-4">Contatti</h4>
        <ul class="space-y-3">
          <li>
            <a href={MAPS_URL} target="_blank" rel="noopener" class="flex items-start gap-3 text-gray-400 hover:text-white text-sm transition-colors">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <span>{ADDRESS}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${PHONE_NUMBER.replace(/-/g, '')}`} class="flex items-center gap-3 text-gray-400 hover:text-white text-sm transition-colors">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <span>{PHONE_NUMBER}</span>
            </a>
          </li>
          <li class="flex items-center gap-3 text-gray-400 text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>18:00 - 22:00 tutti i giorni</span>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        © {currentYear} {SITE_NAME}. Tutti i diritti riservati.
      </p>
      <p class="text-gray-600 text-xs">
        Sito realizzato da <a href="https://bitora.it" target="_blank" rel="noopener" class="text-gray-500 hover:text-white transition-colors">bitora.it</a>
      </p>
    </div>
  </div>
</footer>
