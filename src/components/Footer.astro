---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 py-12 border-t-4 border-red-600 relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
      
      <!-- Brand & Address -->
      <div class="space-y-4">
        <h3 class="text-2xl font-serif font-bold text-white tracking-tight">Speedy Pizza</h3>
        <p class="text-slate-400">
          Via Valobra 117/119<br>
          Carmagnola (TO)
        </p>
      </div>

      <!-- Delivery Info -->
      <div class="flex flex-col items-center md:items-start justify-center space-y-4">
        <div class="inline-block bg-red-900/30 border border-red-500/30 rounded-lg px-4 py-3 backdrop-blur-sm">
          <p class="text-red-400 font-semibold flex items-center gap-2">
            <span>🚚</span> Consegna a domicilio (€2,00)
          </p>
          <p class="text-slate-400 text-sm mt-1">Asporto disponibile</p>
        </div>
      </div>

      <!-- Credits & Copyright -->
      <div class="flex flex-col justify-center md:justify-end space-y-4">
        <p class="text-sm text-slate-500">
          &copy; {currentYear} Speedy Pizza.<br>Tutti i diritti riservati.
        </p>
        <p class="text-sm text-slate-500">
          Sito realizzato da <a href="https://bitora.it" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-white transition-colors font-medium">bitora.it</a>
        </p>
      </div>

    </div>
  </div>
  
  <!-- Decorative background element -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-10">
    <div class="absolute -top-24 -right-24 w-64 h-64 bg-red-600 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-orange-500 rounded-full blur-3xl"></div>
  </div>
</footer>
